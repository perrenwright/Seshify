# Stormglass.io API Key
STORMGLASS_KEY=your_stormglass_api_key_here

# Telegram Bot API Configuration
TG_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_chat_id_or_channel_username_here

# LLM Reasoning Configuration (Provide at least one of these)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Coordinate Settings (Defaults to Huntington Beach, CA)
SURF_LAT=33.6839
SURF_LNG=-118.0122
